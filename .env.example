# Example Environment Variables (Safe to commit)
# Copy this file to .env and fill in your actual credentials

# Application Secrets
APP_SECRET_KEY=
SESSION_SECRET=

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database
DB_USER=postgres
DB_PASSWORD=

# Service Passwords / Tokens
AUTH_TOKEN=

